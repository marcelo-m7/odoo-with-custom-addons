<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="action_progress_view" model="ir.actions.act_window">
        <field name="name">Progress</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('order_id.project_id','=', active_id)]</field>
    </record>

    <record id="action_window_boms" model="ir.actions.act_window">
        <field name="name">BoMs</field>
        <field name="domain">[('is_template', '=', True)]</field>
        <field name="res_model">mrp.bom</field>
        <field name="context">{'search_default_active': True}</field>
    </record>
    <record id="action_window_see_boms_from_product_template" model="ir.actions.act_window">
        <field name="name">BoMs</field>
        <field name="domain">[('is_template', '=', True), ('bom_line_ids.product_id.product_tmpl_id', '=', active_id)]</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': True}</field>
    </record>
    <record id="action_window_see_boms_from_product_product" model="ir.actions.act_window">
        <field name="name">BoMs</field>
        <field name="domain">[('is_template', '=', True), ('bom_line_ids.product_id', '=', active_id)]</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': True}</field>
    </record>
    <record id="action_window_add_bom" model="ir.actions.act_window">
        <field name="name">Add BoM</field>
        <field name="domain">[('active', '=', True),('is_template', '=', True)]</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_is_template': False, 'default_targeted_so_id': context.get('so_id')}</field>
    </record>
<!-- procurement -->
    <record id="action_project_mrp_bom_line_view_from_project" model="ir.actions.act_window">
        <field name="name">Procurement</field>
        <field name="res_model">mrp.bom.line</field>
        <field name="domain">[('sale_order_id.project_id', '=', active_id), ('cost_nature', '=', 'material')]</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_project_mrp_bom_line_view_from_so" model="ir.actions.act_window">
        <field name="name">Procurement</field>
        <field name="res_model">mrp.bom.line</field>
        <field name="domain">[('sale_order_id', '=', active_id), ('cost_nature', '=', 'material')]</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_product': True}</field>
    </record>
    <record id="action_project_mrp_bom_line_view_from_menu" model="ir.actions.act_window">
        <field name="name">Procurement</field>
        <field name="res_model">mrp.bom.line</field>
        <field name="domain">[('bom_id.is_template', '=', False), ('cost_nature', '=', 'material')]</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_product': True}</field>
    </record>

<!-- remark -->
    <record id="action_project_construction_remark_kanban_view" model="ir.actions.act_window">
        <field name="name">Remarks</field>
        <field name="res_model">construction.remark</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
        <!-- 
            default_project_id: for the remark's project_id
            default_project_ids: to assign the current project when quick creating stages in kanban view
        -->
        <field name="context">{
            'search_default_open_remarks': 1,
            'default_project_id': active_id,
            'default_project_ids': [active_id],
            'force_open_attachments': 1,
        }</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help"><![CDATA[
            <p class="o_view_nocontent_smiling_face">
                No remarks, let's create one!
            </p>
        ]]></field>
    </record>
    <record id="menu_action_project_construction_remark_kanban_view" model="ir.actions.act_window">
        <field name="name">Remarks</field>
        <field name="res_model">construction.remark</field>
        <field name="view_mode">list,form</field>
        <field name="context" eval="{
            'search_default_open_remarks': 1,
            'force_open_attachments': 1,
        }"/>
        <field name="help"><![CDATA[
            <p class="o_view_nocontent_smiling_face">
                No remarks, let's create one!
            </p>
        ]]></field>
    </record>
<!-- remark category -->
    <record id="menu_action_construction_remark_category_list_view" model="ir.actions.act_window">
        <field name="name">Remark Categories</field>
        <field name="res_model">construction.remark.category</field>
        <field name="view_mode">list,form</field>
    </record>
<!-- remark stage -->
    <record id="menu_action_construction_remark_stage_list_view" model="ir.actions.act_window">
        <field name="name">Remark Stages</field>
        <field name="res_model">construction.remark.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
